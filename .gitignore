# ============================================================
#  .gitignore — Yogesh Portfolio
#  Trainer: Eluri Narendra | Agentic AI SDLC
# ============================================================

# Environment variables — NEVER commit credentials
.env
.env.local
.env.*.local
.env.production
.env.development

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Build / dist output
dist/
build/
out/

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage / testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/
